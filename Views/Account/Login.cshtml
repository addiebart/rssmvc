@{
    ViewData["Title"] = "Login";
}
@model RssAsp.Models.AccountInputModel

<div class="grid min-h-full place-items-center p-4">
    <section class="w-full max-w-md rounded-lg border border-gray-200 bg-white p-9 shadow-sm dark:border-slate-800 dark:bg-[#202020]" aria-labelledby="account-heading">
        <p id="account-eyebrow" class="mb-1 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Welcome back</p>
        <h1 id="account-heading" class="mb-0 text-2xl font-semibold dark:text-gray-100">Log in to RssAsp</h1>
        <p id="account-description" class="my-3 mb-7 text-gray-500 dark:text-gray-400">Read everything you follow in one place.</p>

        <form id="account-form" asp-controller="Account" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>
            <input id="is-registering" asp-for="IsRegistering" type="hidden"/>
            <div class="mb-3">
                <label for="username" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Username</label>
                <input id="username" asp-for="Username" class="block w-full rounded border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500 dark:border-slate-700 dark:bg-[#171717] dark:text-gray-100" type="text" autocomplete="username" placeholder="Enter your username">
            </div>

            <div class="mb-4">
                <label for="password" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Password</label>
                <input id="password" asp-for="Password" class="block w-full rounded border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500 dark:border-slate-700 dark:bg-[#171717] dark:text-gray-100" type="password" autocomplete="current-password" placeholder="Enter your password">
            </div>
            <button id="account-submit" type="submit" class="w-full cursor-pointer rounded bg-gray-900 px-3 py-2 text-white hover:bg-gray-700 dark:bg-slate-700 dark:hover:bg-slate-600">Log in</button>
        </form>
        <p class="mt-5 text-center text-sm text-gray-500 dark:text-gray-400">
            <span id="account-switch-prompt">Need an account?</span>
            <button id="account-switch" type="button" class="ml-1 cursor-pointer font-medium text-gray-900 underline hover:text-gray-700 dark:text-gray-100 dark:hover:text-gray-300">Register</button>
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-4">
                <button type="submit" class="w-full cursor-pointer rounded border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:border-slate-700 dark:text-gray-300 dark:hover:bg-slate-800">
                    Log out
                </button>
            </form>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/account.js" asp-append-version="true"></script>
}
