@model RssAsp.Models.ArticleDetailsViewModel

@{
    ViewData["Title"] = Model.Article.Title;
}

<main class="mx-auto w-full max-w-5xl p-6 md:p-9">
    <a asp-action="Index" class="mb-6 inline-flex items-center gap-2 rounded px-2 py-1 text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-slate-800 dark:hover:text-gray-100" aria-label="Back to articles">
        <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
            <path d="m9.25 4.25-5.5 5.5a.35.35 0 0 0 0 .5l5.5 5.5.5-.5L5.1 10.6H16v-1H5.1l4.65-4.65-.5-.5Z"/>
        </svg>
        <span>Back to articles</span>
    </a>

    <article class="rounded-lg border border-gray-200 bg-white p-6 md:p-9 dark:border-slate-800 dark:bg-[#202020]">
        <p class="mb-2 text-sm font-semibold text-gray-600 dark:text-gray-300">@Model.FeedName</p>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 md:text-3xl">@Model.Article.Title</h1>
        <time class="mt-2 block text-xs text-gray-500 dark:text-gray-400" datetime="@Model.Article.PublishedAt.ToString("O")">
            @Model.Article.PublishedAt.ToLocalTime().ToString("g")
        </time>

        @if (!string.IsNullOrWhiteSpace(Model.Article.ImageUrl))
        {
            <img src="@Model.Article.ImageUrl"
                 alt=""
                 loading="lazy"
                 class="mx-auto my-7 max-h-[70vh] w-auto max-w-full rounded object-contain">
        }

        <div class="text-sm leading-6 text-gray-700 dark:text-gray-300 [&_a]:underline [&_a]:hover:text-gray-900 dark:[&_a]:hover:text-gray-100">
            @Html.Raw(Model.Article.Summary)
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Article.Url))
        {
            <a href="@Model.Article.Url" target="_blank" rel="noopener noreferrer" class="mt-7 inline-block text-sm font-semibold text-gray-600 hover:text-gray-900 hover:underline dark:text-gray-300 dark:hover:text-gray-100">
                Read original article
            </a>
        }
    </article>
</main>
