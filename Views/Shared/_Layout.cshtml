<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - RssAsp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/RssAsp.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body class="dark m-0 flex min-h-screen flex-col bg-slate-50 font-sans text-gray-900 antialiased dark:bg-[#171717] dark:text-gray-100">
<header>
    <nav class="border-b border-gray-200 bg-white shadow-sm dark:border-slate-800 dark:bg-[#1d1d1d]">
        <div class="flex items-center justify-between px-4 py-3">
            <a class="font-semibold text-gray-900 no-underline dark:text-gray-100" asp-area="" asp-controller="Home" asp-action="Index">RssAsp</a>
            <div class="flex gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="inline-flex items-center px-3 py-2 text-sm text-gray-600 dark:text-gray-300">
                        Signed in as: @User.Identity.Name
                    </span>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="cursor-pointer rounded bg-gray-900 px-3 py-2 text-sm text-white hover:bg-gray-700 dark:bg-slate-700 dark:hover:bg-slate-600">
                            Log out
                        </button>
                    </form>
                }
                else
                {
                    <a class="inline-block rounded bg-gray-900 px-3 py-2 text-sm text-white no-underline hover:bg-gray-700 dark:bg-slate-700 dark:hover:bg-slate-600" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>
        </div>
    </nav>
</header>
<main role="main" class="flex flex-1 flex-col">
        @RenderBody()
</main>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>